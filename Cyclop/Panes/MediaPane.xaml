<UserControl x:Class="Cyclop.Panes.MediaPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="Player" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Artwork: a YouTube thumbnail is 16:9 and is fitted, not cropped. -->
            <Border Width="118" Height="118" CornerRadius="14" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,116,116" RadiusX="13" RadiusY="13" />
                    </Grid.Clip>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="30"
                               Foreground="{StaticResource Tertiary}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image x:Name="Art" Source="{Binding Artwork}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <Grid Grid.Column="2" Height="118">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Secondary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- Where it plays. With more than one app playing, a click
                         moves to the next one. -->
                    <Button x:Name="SourceButton" Grid.Column="1" Style="{StaticResource Flat}" Padding="6,1"
                            Foreground="{StaticResource Tertiary}" Click="Source_Click" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source}" FontSize="10.5" />
                            <TextBlock x:Name="SwitchGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE8AB;"
                                       FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="Back10" Style="{StaticResource Flat}" Content="−10" FontSize="10.5"
                            Foreground="{StaticResource Secondary}" Width="34" Height="30" Padding="0"
                            Click="Back10_Click" ToolTip="Back 10 seconds" />
                    <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                            FontSize="14" Width="34" Height="34" Margin="8,0,0,0"
                            Click="Previous_Click" ToolTip="Previous" />
                    <Button x:Name="PlayButton" Style="{StaticResource RoundButton}" Content="&#xE768;"
                            Margin="10,0" Click="Play_Click" ToolTip="Play / pause" />
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                            FontSize="14" Width="34" Height="34" Margin="0,0,8,0"
                            Click="Next_Click" ToolTip="Next" />
                    <Button x:Name="Forward10" Style="{StaticResource Flat}" Content="+10" FontSize="10.5"
                            Foreground="{StaticResource Secondary}" Width="34" Height="30" Padding="0"
                            Click="Forward10_Click" ToolTip="Forward 10 seconds" />
                </StackPanel>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" FontSize="10" Foreground="{StaticResource Tertiary}"
                               VerticalAlignment="Center" Text="0:00" />
                    <!-- The scrubber: click or drag anywhere on it to seek. -->
                    <Grid x:Name="Track" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Track_Down" MouseMove="Track_Move" MouseLeftButtonUp="Track_Up"
                          MouseEnter="Track_Hover" MouseLeave="Track_Hover" SizeChanged="Track_SizeChanged">
                        <Border x:Name="Rail" Height="4" CornerRadius="2" Background="{StaticResource SurfaceHover}"
                                VerticalAlignment="Center" />
                        <Border x:Name="Fill" Height="4" CornerRadius="2" Background="#E6FFFFFF" Width="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Ellipse x:Name="Knob" Width="11" Height="11" Fill="White" Visibility="Hidden"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="Total" Grid.Column="2" FontSize="10" Foreground="{StaticResource Tertiary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00" />
                </Grid>
            </Grid>
        </Grid>

        <StackPanel x:Name="Empty" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="22"
                       Foreground="{StaticResource Tertiary}" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing is playing" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Play a video on YouTube in any browser, or music in any app, and it shows up here." />
        </StackPanel>
    </Grid>
</UserControl>
