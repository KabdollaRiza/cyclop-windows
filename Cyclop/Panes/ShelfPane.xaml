<UserControl x:Class="Cyclop.Panes.ShelfPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="Scroller_Wheel">
            <ItemsControl x:Name="List" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="88" Height="100" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1.5"
                                ToolTip="{Binding Path}"
                                MouseLeftButtonDown="Card_Down" MouseMove="Card_Move" MouseLeftButtonUp="Card_Up">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="Copy_Click" />
                                    <MenuItem Header="Open" Click="Open_Click" />
                                    <MenuItem Header="Show in Explorer" Click="Reveal_Click" />
                                    <Separator />
                                    <MenuItem Header="Remove from shelf" Click="Remove_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <StackPanel Margin="6,10,6,6">
                                    <Grid Width="72" Height="46">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock x:Name="Fallback" FontFamily="{StaticResource IconFont}" Text="&#xE8A5;"
                                                   FontSize="26" Foreground="{StaticResource Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource Secondary}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               MaxHeight="28" Margin="0,6,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="Check" FontFamily="{StaticResource IconFont}" Text="&#xE73E;"
                                           FontSize="11" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Visibility="Collapsed" />
                                <Button x:Name="Remove" Style="{StaticResource IconButton}" Width="20" Height="20"
                                        FontSize="9" Content="&#xE711;" Opacity="0" Margin="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="Remove_Click" ToolTip="Remove from shelf" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter TargetName="Remove" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#2EFFFFFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#8CFFFFFF" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty: the whole pane is a drop zone. -->
        <Grid x:Name="Empty">
            <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                       StrokeDashArray="4 3" Stroke="{StaticResource Hairline}" Fill="Transparent" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="20"
                           Foreground="{StaticResource Tertiary}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Drop files here. Screenshots you take land here by themselves." />
            </StackPanel>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="1" Margin="0,4,0,0">
            <TextBlock x:Name="SelectedText" Foreground="{StaticResource Tertiary}" FontSize="10"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeselectButton" Style="{StaticResource Flat}" Foreground="{StaticResource Secondary}"
                        Content="Deselect" Click="Deselect_Click" />
                <Button Style="{StaticResource Flat}" Foreground="{StaticResource Secondary}"
                        Content="Screenshots folder" Click="Folder_Click" />
                <Button Style="{StaticResource Flat}" Foreground="{StaticResource Secondary}"
                        Content="Clear" Click="Clear_Click" ToolTip="Empties the shelf; the files stay where they are" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
