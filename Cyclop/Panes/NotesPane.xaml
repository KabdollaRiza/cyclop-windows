<UserControl x:Class="Cyclop.Panes.NotesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Style="{StaticResource Flat}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="{StaticResource Surface}" Click="New_Click" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="New note" />
                </StackPanel>
            </Button>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="8,5"
                                    Margin="0,0,0,1" MouseLeftButtonUp="Row_Click">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHover}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="2">
            <TextBox x:Name="Editor" Style="{StaticResource Field}" Tag="Write something down…"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Hidden"
                     TextChanged="Editor_TextChanged" />
            <Button x:Name="Delete" Style="{StaticResource IconButton}" Content="&#xE74D;"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                    Foreground="{StaticResource Secondary}" Click="Delete_Click" ToolTip="Delete note" />
            <TextBlock x:Name="Empty" Style="{StaticResource Hint}"
                       Text="Scratch space for an hour.&#x0a;Start with “New note”; empty notes clear themselves." />
        </Grid>
    </Grid>
</UserControl>
