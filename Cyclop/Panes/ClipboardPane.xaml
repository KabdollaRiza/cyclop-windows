<UserControl x:Class="Cyclop.Panes.ClipboardPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="8,5" Margin="0,0,0,1"
                                MouseLeftButtonUp="Row_Click" ToolTip="Click to copy">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}"
                                           Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button x:Name="Remove" Grid.Column="2" Style="{StaticResource IconButton}"
                                        Width="20" Height="20" FontSize="9" Content="&#xE711;" Opacity="0"
                                        Click="Remove_Click" ToolTip="Remove" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Remove" Property="Opacity" Value="1" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Empty" Style="{StaticResource Hint}"
                   Text="Copy something — it will show up here.&#x0a;The last 40 copies are kept until Cyclop quits." />

        <Button x:Name="ClearButton" Grid.Row="1" Style="{StaticResource Flat}" HorizontalAlignment="Right"
                Foreground="{StaticResource Secondary}" Content="Clear all" Click="Clear_Click" Margin="0,2,0,0" />
    </Grid>
</UserControl>
